{
  "name": "blog",
  "version": "1.0.0",
  "description": "blog by alfe",
  "private": true,
  "author": "alfe (https://github.com/alfe/)",
  "homepage": "https://blog.alfebelow.com/",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build && next-sitemap",
    "start": "next start",
    "postbuild": "next-sitemap",
    "deploy": "netlify deploy --prod --skip-functions-cache",
    "postdeploy": "node -e \"require('fs').rmSync('deno.lock', { force: true })\"",
    "lint": "yarn lint:biome && yarn lint:oxlint && yarn lint:eslint",
    "lint:biome": "biome lint .",
    "lint:oxlint": "oxlint --import-plugin --react-plugin --jsx-a11y-plugin --nextjs-plugin --deny correctness --deny suspicious --deny perf --allow style --allow react-in-jsx-scope --ignore-pattern \".netlify/**\" --ignore-pattern \".next/**\" --ignore-pattern \".yarn/**\" --ignore-pattern \"out/**\" --ignore-pattern \"build/**\" --ignore-pattern \"storybook-static/**\" --ignore-pattern \"public/**\" --ignore-pattern \"__snapshots__/**\" --ignore-pattern \"**/*.stories.*\" --ignore-pattern \"components/**/__stories__/**\" .",
    "lint:eslint": "eslint \"**/*.stories.{js,jsx,ts,tsx}\" \"components/**/__stories__/**/*.{js,jsx,ts,tsx}\" --no-error-on-unmatched-pattern",
    "textlint": "npx textlint --fix ./content/posts/2023/**/*.md",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-ct": "playwright test -c playwright-ct.config.ts"
  },
  "dependencies": {
    "dayjs": "^1.11.21",
    "feed": "^5.2.1",
    "ga-gtag": "^1.2.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^29.1.1",
    "next": "^16.2.9",
    "next-sitemap": "^4.2.3",
    "open-graph-scraper": "^6.12.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rehype-parse": "9.0.1",
    "rehype-react": "^8.0.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "remark-strip-html": "^1.0.2",
    "request": "^2.88.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@netlify/plugin-nextjs": "^5.15.12",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/addon-links": "10.4.6",
    "@storybook/addon-onboarding": "10.4.6",
    "@storybook/nextjs": "10.4.6",
    "@textlint-ja/textlint-rule-no-insert-dropping-sa": "^2.0.1",
    "@textlint-ja/textlint-rule-no-synonyms": "^1.3.0",
    "@textlint-ja/textlint-rule-preset-ai-writing": "^1.7.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/request": "^2.48.13",
    "eslint": "^9.37.0",
    "eslint-config-next": "16.2.9",
    "eslint-plugin-storybook": "10.4.6",
    "oxlint": "^1.72.0",
    "playwright": "^1.61.1",
    "storybook": "10.4.6",
    "sudachi-synonyms-dictionary": "^18.0.0",
    "textlint": "^15.7.1",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-date-weekday-mismatch": "^1.1.1",
    "textlint-rule-ja-hiragana-fukushi": "^1.3.0",
    "textlint-rule-ja-hiragana-hojodoushi": "^1.1.0",
    "textlint-rule-ja-hiragana-keishikimeishi": "^1.1.0",
    "textlint-rule-ja-no-inappropriate-words": "^2.0.0",
    "textlint-rule-no-mixed-zenkaku-and-hankaku-alphabet": "^1.0.1",
    "textlint-rule-no-start-duplicated-conjunction": "^2.0.2",
    "textlint-rule-preset-ja-spacing": "^3.0.2",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-preset-japanese": "^10.0.4",
    "typescript": "^6.0.3"
  },
  "packageManager": "yarn@4.14.1",
  "resolutions": {
    "unified": "11.0.5"
  }
}
